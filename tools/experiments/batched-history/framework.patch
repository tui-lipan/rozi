+use criterion::{BenchmarkId, Criterion, Throughput, criterion_group, criterion_main};
+use std::hint::black_box;
+use tui_lipan::prelude::TerminalScreen;
+fn settled(c: &mut Criterion) {
+    let mut group = c.benchmark_group("sustained_and_drain");
+    for cols in [80, 253] {
+        for kind in ["plain", "unicode", "dense"] {
+            let line = match kind {
+                "unicode" => "東京 e\u{301} 🦀 log record\r\n".to_owned(),
+                "dense" => {
+                    let mut s: String = (0..cols)
+                        .map(|i| char::from(b'a' + (i % 26) as u8))
+                        .collect();
+                    s.push_str("\r\n");
+                    s
+                }
+                _ => "short log record\r\n".to_owned(),
+            };
+            let input = line.repeat(100000);
+            group.throughput(Throughput::Bytes(input.len() as u64));
+            group.bench_function(BenchmarkId::new(kind, cols), |b| {
+                let mut screen = TerminalScreen::new(64, cols, 5000);
+                screen.process_bytes(line.repeat(5100).as_bytes());
+                screen.finish_history_compaction();
+                b.iter(|| {
+                    screen.process_bytes(black_box(input.as_bytes()));
+                    screen.finish_history_compaction();
+                });
+                assert_eq!(screen.total_scrollback_rows(), 5000);
+            });
+        }
+    }
+    group.finish();
+}
+criterion_group!(benches, settled);
+criterion_main!(benches);
