+    let scrolled: Vec<_> = grid.display_iter().map(|indexed| indexed.cell.c).collect();
+    let mut mixed = Vec::new();
+    for row in 0..2 {
+        let view = grid.display_row(row);
+        for col in 0..3 {
+            mixed.push(view.cell(Column(col)).c);
+        }
+    }
