@@ -0,0 +1,93 @@
+//! Preserve upstream grid fixtures without serializing storage caches or expanding history.
+use super::*;
+use serde::ser::{SerializeSeq, SerializeStruct};
+use serde::{Deserialize, Deserializer, Serialize, Serializer};
+
+impl<T: Serialize> Serialize for RowView<'_, T> {
+    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        struct Cells<'a, T>(RowView<'a, T>);
+        impl<T: Serialize> Serialize for Cells<'_, T> {
+            fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+                let mut seq = serializer.serialize_seq(Some(self.0.len()))?;
+                for cell in self.0.iter() {
+                    seq.serialize_element(cell)?;
+                }
+                seq.end()
+            }
+        }
+        let mut row = serializer.serialize_struct("Row", 2)?;
+        row.serialize_field("inner", &Cells(*self))?;
+        row.serialize_field("occ", &self.occ())?;
+        row.end()
+    }
+}
+impl<T: Serialize> Serialize for Grid<T> {
+    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        struct Rows<'a, T>(&'a Grid<T>);
+        impl<T: Serialize> Serialize for Rows<'_, T> {
+            fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+                let grid = self.0;
+                let mut seq = serializer.serialize_seq(Some(grid.total_lines()))?;
+                for line in (-(grid.history.len() as i32)..grid.lines as i32).rev() {
+                    seq.serialize_element(&grid.read_row(Line(line)))?;
+                }
+                seq.end()
+            }
+        }
+        struct Raw<'a, T>(&'a Grid<T>);
+        impl<T: Serialize> Serialize for Raw<'_, T> {
+            fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+                let mut raw = serializer.serialize_struct("Storage", 4)?;
+                raw.serialize_field("inner", &Rows(self.0))?;
+                raw.serialize_field("zero", &0usize)?;
+                raw.serialize_field("visible_lines", &self.0.lines)?;
+                raw.serialize_field("len", &self.0.total_lines())?;
+                raw.end()
+            }
+        }
+        let mut grid = serializer.serialize_struct("Grid", 5)?;
+        grid.serialize_field("raw", &Raw(self))?;
+        grid.serialize_field("columns", &self.columns)?;
+        grid.serialize_field("lines", &self.lines)?;
+        grid.serialize_field("display_offset", &self.display_offset)?;
+        grid.serialize_field("max_scroll_limit", &self.max_scroll_limit)?;
+        grid.end()
+    }
+}
+impl<'de, T: Deserialize<'de> + Default + Clone + PartialEq> Deserialize<'de> for Grid<T> {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        #[derive(Deserialize)]
+        struct Wire<T> {
+            raw: Storage<T>,
+            columns: usize,
+            lines: usize,
+            display_offset: usize,
+            max_scroll_limit: usize,
+        }
+        let wire = Wire::deserialize(deserializer)?;
+        let mut grid = Grid {
+            raw: wire.raw,
+            columns: wire.columns,
+            lines: wire.lines,
+            display_offset: wire.display_offset,
+            max_scroll_limit: wire.max_scroll_limit,
+            history: VecDeque::new(),
+            row_pool: RowPool::default(),
+            cursor: Cursor::default(),
+            saved_cursor: Cursor::default(),
+        };
+        // Older reference files encode an off-by-one storage viewport count. Their
