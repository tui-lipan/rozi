+#[cfg(test)]
+mod iteration_tests {
+    use super::tests::compact_pool;
+    use super::*;
+    use crate::term::cell::Cell;
+    use crate::vte::ansi::{Color, NamedColor};
+
+    #[test]
+    fn mixed_iteration_and_last_matching_preserve_dense_semantics() {
+        let mut pool = compact_pool();
+        pool.set_width(80);
+        let mut dense = Row::<Cell>::new(80);
+        dense[Column(0)].c = 'a';
+        dense[Column(1)].c = 'b';
+        let expected: Vec<_> = dense.inner.clone();
+        let history = HistoryRow::from_dense(dense, &mut pool);
+        let view = history.view();
+        assert_eq!(view.last_matching(|cell| cell.c == 'b'), Some(1));
+        assert_eq!(view.last_matching(|cell| cell.c == ' '), Some(79));
+        assert_eq!(view.last_matching(|cell| cell.c == 'x'), None);
+        let mut cells = view.iter();
+        for index in 0..40 {
+            assert_eq!(cells.len(), 80 - index * 2);
+            assert_eq!(cells.next(), Some(&expected[index]));
+            assert_eq!(cells.next_back(), Some(&expected[79 - index]));
+        }
+        assert_eq!(cells.next(), None);
+        assert_eq!(cells.next_back(), None);
+        assert_eq!(cells.len(), 0);
+    }
+
+    #[test]
+    fn direct_resize_requires_default_tail_and_preserves_prefix() {
+        let mut pool = compact_pool();
+        pool.set_width(80);
+        let mut dense = Row::<Cell>::new(80);
+        dense[Column(4)].c = 'x';
+        let mut history = HistoryRow::from_dense(dense, &mut pool);
+        assert!(!history.resize_default_tail(4));
+        assert!(history.resize_default_tail(5));
+        assert_eq!(history.view().cell(Column(4)).c, 'x');
+        assert!(history.resize_default_tail(120));
+        assert_eq!(history.view().cell(Column(119)), &Cell::default());
+        let mut dense = Row::<Cell>::new(80);
+        for cell in &mut dense[Column(0)..] {
+            cell.bg = Color::Named(NamedColor::Red);
+        }
+        let mut history = HistoryRow::from_dense(dense, &mut pool);
+        assert!(!history.resize_default_tail(120));
+        assert_eq!(history.view().len(), 80);
+    }
+
+    #[test]
+    fn copy_into_preserves_prefix_and_repeated_tail() {
+        let mut pool = compact_pool();
+        pool.set_width(80);
+        let mut dense = Row::<Cell>::new(80);
+        dense[Column(0)].c = 'a';
+        dense[Column(1)].c = 'b';
+        let expected = dense.inner.clone();
+        let history = HistoryRow::from_dense(dense, &mut pool);
+        assert!(matches!(history, HistoryRow::Compact(_)));
+        match history.view().parts() {
+            RowParts::Compact { prefix, tail_count, .. } => {
+                assert_eq!(prefix.len(), 2);
+                assert_eq!(tail_count, 78);
+            },
+            RowParts::Dense(_) => panic!("expected compact parts"),
+        }
+        let mut dest = vec![Cell::default(); 80];
+        history.view().copy_into(&mut dest);
+        assert_eq!(dest, expected);
+    }
+}
