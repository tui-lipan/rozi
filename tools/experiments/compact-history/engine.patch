+    /// Compact only when at least half the cell allocation can be released.
+    pub fn compact(&mut self) {
+        let Some(tail) = self.inner.last() else {
+            return;
+        };
+        // `occ` bounds all modified cells; the remaining tail is already known equal.
+        let modified = min(self.occ, self.inner.len());
+        let prefix = self.inner[..modified]
+            .iter()
+            .rposition(|cell| cell != tail)
+            .map_or(0, |i| i + 1);
+        let stored = prefix + 1;
+        if stored > self.columns / 2 {
+            return;
+        }
+        self.inner.truncate(stored);
+        self.inner.shrink_to_fit();
+    }
+}
