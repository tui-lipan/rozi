{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rozi.tui-lipan.dev/schemas/extension.schema.json",
  "title": "Rozi extension manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "extension"
  ],
  "properties": {
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "api"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "api": {
          "const": 1
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "label": {
            "type": "string"
          },
          "exec": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "shell": {
            "type": "string",
            "minLength": 1
          },
          "send": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "description": "Suggested chord, as the key steps inside the reserved extension space: \"b\" means <prefix> x b."
          }
        },
        "oneOf": [
          {
            "required": [
              "exec"
            ]
          },
          {
            "required": [
              "shell"
            ]
          },
          {
            "required": [
              "send"
            ]
          }
        ]
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "exec": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "shell": {
            "type": "string",
            "minLength": 1
          },
          "cwd": {
            "type": "string"
          },
          "restart": {
            "enum": [
              "on-failure",
              "always",
              "never"
            ]
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "exec"
            ]
          },
          {
            "required": [
              "shell"
            ]
          }
        ]
      }
    },
    "navigation_targets": {
      "type": "array",
      "description": "Static foreground-program registrations for split-aware smart-focus routing.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "programs"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "programs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "suggested_keybindings": {
      "type": "array",
      "description": "Best-effort bindings for explicitly extension-bindable core actions.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "key"
        ],
        "properties": {
          "action": {
            "enum": [
              "smart-focus-left",
              "smart-focus-down",
              "smart-focus-up",
              "smart-focus-right"
            ]
          },
          "key": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "description": "Agent definitions. Ids are namespaced <extension>.<id> once loaded.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "match"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "label": {
            "type": "string"
          },
          "base": {
            "type": "boolean",
            "description": "Apply Rozi's shared blocked/working vocabulary. Defaults to true."
          },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "names": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "anyOf": [
              {
                "required": [
                  "names"
                ]
              },
              {
                "required": [
                  "paths"
                ]
              }
            ]
          },
          "states": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "blocked",
                    "working",
                    "idle",
                    "unknown"
                  ]
                },
                "scope": {
                  "enum": [
                    "all",
                    "footer"
                  ],
                  "description": "`screen` rules only. `footer` reads the last 8 non-empty lines."
                },
                "screen": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Needles over one observation. Matched against text Rozi has already lowercased.",
                  "properties": {
                    "all_of": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "any_of": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "none_of": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "regex": {
                      "type": "boolean",
                      "description": "Treat every needle in this group as a regular expression."
                    }
                  },
                  "anyOf": [
                    {
                      "required": [
                        "all_of"
                      ]
                    },
                    {
                      "required": [
                        "any_of"
                      ]
                    }
                  ]
                },
                "title": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Needles over one observation. Matched against text Rozi has already lowercased.",
                  "properties": {
                    "all_of": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "any_of": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "none_of": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "regex": {
                      "type": "boolean",
                      "description": "Treat every needle in this group as a regular expression."
                    }
                  },
                  "anyOf": [
                    {
                      "required": [
                        "all_of"
                      ]
                    },
                    {
                      "required": [
                        "any_of"
                      ]
                    }
                  ]
                }
              },
              "oneOf": [
                {
                  "required": [
                    "screen"
                  ]
                },
                {
                  "required": [
                    "title"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    "sidebar_tabs": {
      "type": "array",
      "description": "Sidebar tabs. Ids are namespaced <extension>.<name> once loaded.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "label"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "group": {
                  "type": "string",
                  "description": "Section header this entry sits under."
                },
                "run": {
                  "type": "string",
                  "minLength": 1
                },
                "send": {
                  "type": "string",
                  "minLength": 1
                },
                "popup": {
                  "type": "string",
                  "minLength": 1
                },
                "keep_open": {
                  "type": "boolean"
                }
              },
              "oneOf": [
                {
                  "required": [
                    "run"
                  ]
                },
                {
                  "required": [
                    "send"
                  ]
                },
                {
                  "required": [
                    "popup"
                  ]
                }
              ]
            }
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "interval": {
            "type": "integer",
            "minimum": 1
          },
          "on_click": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "run": {
                "type": "string",
                "minLength": 1
              },
              "send": {
                "type": "string",
                "minLength": 1
              },
              "popup": {
                "type": "string",
                "minLength": 1
              },
              "exec": {
                "type": "string",
                "minLength": 1
              },
              "keep_open": {
                "type": "boolean"
              }
            },
            "oneOf": [
              {
                "required": [
                  "run"
                ]
              },
              {
                "required": [
                  "send"
                ]
              },
              {
                "required": [
                  "popup"
                ]
              },
              {
                "required": [
                  "exec"
                ]
              }
            ]
          },
          "group_prefix": {
            "type": "string",
            "minLength": 1,
            "description": "Command tabs only. Output lines starting with it render as section headers."
          }
        },
        "oneOf": [
          {
            "required": [
              "entries"
            ]
          },
          {
            "required": [
              "command"
            ]
          }
        ]
      }
    },
    "settings": {
      "type": "object",
      "description": "Settings this extension understands, each at its default value. Users override them in [extensions.<id>].",
      "propertyNames": {
        "pattern": "^[a-z0-9_-]+$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      }
    }
  }
}
