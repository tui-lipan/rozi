+use alacritty_terminal::grid::history::{HistoryRow, RowPool};
+use alacritty_terminal::grid::{Dimensions, Grid, Row, Scroll};
+use alacritty_terminal::index::{Column, Line};
+use alacritty_terminal::term::cell::Cell;
+use alacritty_terminal::vte::ansi::Color;
+use criterion::{BatchSize, BenchmarkId, Criterion, criterion_group, criterion_main};
+use std::hint::black_box;
+
+fn row() -> Row<Cell> {
+    let mut row = Row::<Cell>::new(253);
+    for (i, c) in "short log record".chars().enumerate() {
+        row[Column(i)].c = c;
+    }
+    row
+}
+fn pool() -> RowPool<Cell> {
+    let mut pool = RowPool::default();
+    pool.set_width(253);
+    pool.set_compact(true);
+    pool
+}
+fn grid() -> Grid<Cell> {
+    let mut grid = Grid::new(64, 253, 5_000);
+    grid.set_compact_history(true);
+    for _ in 0..5_064 {
+        grid[Line(0)] = row();
+        grid.scroll_up::<Color>(&(Line(0)..Line(64)), 1);
+    }
+    grid
+}
+fn dense_grid() -> dense::grid::Grid<dense::term::cell::Cell> {
+    let mut grid = dense::grid::Grid::<dense::term::cell::Cell>::new(64, 253, 5_000);
+    for _ in 0..5_064 {
+        for (i, c) in "short log record".chars().enumerate() {
+            grid[dense::index::Line(0)][dense::index::Column(i)].c = c;
+        }
+        grid.scroll_up::<Color>(&(dense::index::Line(0)..dense::index::Line(64)), 1);
+    }
+    grid
+}
+fn boundaries(c: &mut Criterion) {
+    let mut group = c.benchmark_group("history_representation");
+    group.bench_function("dense_to_compact", |b| {
+        b.iter_batched(
+            || (row(), pool()),
+            |(row, mut pool)| black_box((HistoryRow::from_dense(row, &mut pool), pool)),
+            BatchSize::PerIteration,
+        )
+    });
+    group.bench_function("dense_to_compact_pooled", |b| {
+        b.iter_batched(
+            || {
+                let mut pool = pool();
+                let history = HistoryRow::from_dense(row(), &mut pool);
+                let dense = history.into_dense(&mut pool);
+                (dense, pool)
+            },
+            |(row, mut pool)| black_box((HistoryRow::from_dense(row, &mut pool), pool)),
+            BatchSize::PerIteration,
+        )
+    });
+    group.bench_function("compact_to_dense_pooled", |b| {
+        b.iter_batched(
+            || {
+                let mut pool = pool();
+                (HistoryRow::from_dense(row(), &mut pool), pool)
+            },
+            |(row, mut pool)| black_box((row.into_dense(&mut pool), pool)),
+            BatchSize::PerIteration,
+        )
+    });
+    group.bench_function("compact_eviction", |b| {
+        b.iter_batched_ref(
+            || {
+                let mut pool = pool();
+                (Some(HistoryRow::from_dense(row(), &mut pool)), pool)
+            },
+            |(row, pool)| row.take().unwrap().recycle(pool),
+            BatchSize::PerIteration,
+        )
+    });
+    let split = grid();
+    let dense = dense_grid();
+    for reflow in [false, true] {
+        group.bench_function(BenchmarkId::new("split_resize_253_to_80", reflow), |b| {
+            b.iter_batched_ref(
+                || split.clone(),
+                |grid| grid.resize::<Color>(reflow, 64, 80),
+                BatchSize::PerIteration,
+            );
+        });
+        group.bench_function(BenchmarkId::new("dense_resize_253_to_80", reflow), |b| {
+            b.iter_batched_ref(
+                || dense.clone(),
+                |grid| grid.resize::<Color>(reflow, 64, 80),
+                BatchSize::PerIteration,
+            );
+        });
+    }
+    group.finish();
+}
+
+fn render_access(c: &mut Criterion) {
+    let mut group = c.benchmark_group("history_render_access");
+    let compact = {
+        let mut pool = pool();
+        HistoryRow::from_dense(row(), &mut pool)
+    };
+    group.bench_function("dense_slice_clone", |b| {
+        let dense = row();
+        b.iter_batched_ref(
+            || vec![Cell::default(); 253],
+            |dest| dest.clone_from_slice(dense.cells()),
+            BatchSize::PerIteration,
+        );
+    });
+    group.bench_function("compact_cell_index", |b| {
+        let view = compact.view();
+        b.iter_batched_ref(
+            || vec![Cell::default(); 253],
+            |dest| {
+                for (index, slot) in dest.iter_mut().enumerate() {
+                    *slot = view.cell(Column(index)).clone();
+                }
+            },
+            BatchSize::PerIteration,
+        );
+    });
+    group.bench_function("compact_copy_into", |b| {
+        let view = compact.view();
+        b.iter_batched_ref(
+            || vec![Cell::default(); 253],
+            |dest| view.copy_into(dest),
+            BatchSize::PerIteration,
+        );
+    });
+    let mut live = grid();
+    live.scroll_display(Scroll::Bottom);
+    group.bench_function("display_iter_live", |b| {
+        b.iter(|| {
+            let mut n = 0usize;
+            for indexed in live.display_iter() {
+                n = n.wrapping_add(indexed.cell.c as usize);
+            }
+            black_box(n)
+        });
+    });
+    let mut deep = grid();
+    deep.scroll_display(Scroll::Top);
+    group.bench_function("display_iter_deep", |b| {
+        b.iter(|| {
+            let mut n = 0usize;
+            for indexed in deep.display_iter() {
+                n = n.wrapping_add(indexed.cell.c as usize);
+            }
+            black_box(n)
+        });
+    });
+    group.bench_function("display_row_parts_live", |b| {
+        b.iter(|| {
+            let mut n = 0usize;
+            for row in 0..live.screen_lines() {
