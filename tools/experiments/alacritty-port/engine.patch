+/// Write `text` at the start of the only visible line, then scroll it into history.
+fn push_history_line(grid: &mut Grid<Cell>, text: &str) {
+    for (column, c) in text.chars().enumerate() {
+        grid[Line(0)][Column(column)] = cell(c);
+    }
+    grid.scroll_up::<crate::vte::ansi::Color>(&(Line(0)..Line(1)), 1);
+}
