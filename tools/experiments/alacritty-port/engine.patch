@@ -0,0 +1,530 @@
+//! Explicit cold history storage. Dense viewport cells never dispatch on this representation.
+
+use super::{GridCell, Row};
+use crate::index::Column;
+
+const POOL_ROWS: usize = 4;
+
+/// A row stored as the cells up to its last distinct one, followed by the repeated tail cell.
+///
+/// Prefix and tail share one allocation, and the counts are `u32`, so the row is no larger than a
+/// dense [`Row`].
+#[derive(Clone, Debug)]
+pub struct CompactRow<T> {
+    /// The prefix, then the tail as the last element. Never empty.
+    cells: Vec<T>,
+    columns: u32,
+    occ: u32,
+}
+
+impl<T> CompactRow<T> {
+    fn prefix(&self) -> &[T] {
+        &self.cells[..self.cells.len() - 1]
+    }
+
+    fn tail(&self) -> &T {
+        self.cells.last().expect("a compact row stores its tail")
+    }
+
+    fn columns(&self) -> usize {
+        self.columns as usize
+    }
+
+    fn occ(&self) -> usize {
+        self.occ as usize
+    }
+}
+
+#[derive(Clone, Debug)]
+pub enum HistoryRow<T> {
+    Dense(Row<T>),
+    Compact(CompactRow<T>),
+}
+
+/// A bounded pool shared by scrolling, eviction, and reflow.
+#[derive(Clone, Debug)]
+pub struct RowPool<T> {
+    width: usize,
+    dense: Vec<Row<T>>,
+    prefixes: Vec<Vec<T>>,
+    /// Whether rows entering history may be stored compactly.
+    compact: bool,
+}
+impl<T> Default for RowPool<T> {
+    fn default() -> Self {
+        Self { width: 0, dense: Vec::new(), prefixes: Vec::new(), compact: false }
+    }
+}
+impl<T> RowPool<T> {
+    pub fn set_compact(&mut self, compact: bool) {
+        self.compact = compact;
+    }
+
+    pub fn is_compact(&self) -> bool {
+        self.compact
+    }
+
+    pub fn set_width(&mut self, width: usize) {
+        if self.width == width {
+            return;
+        }
+        self.width = width;
+        self.dense.clear();
+        self.prefixes.clear();
+    }
+
+    fn recycle_dense(&mut self, row: Row<T>) {
+        if row.len() == self.width && self.dense.len() < POOL_ROWS {
+            self.dense.push(row);
+        }
+    }
+
+    fn recycle_prefix(&mut self, mut cells: Vec<T>) {
+        cells.clear();
+        if cells.capacity() <= self.width && self.prefixes.len() < POOL_ROWS {
+            self.prefixes.push(cells);
+        }
+    }
+
+    pub fn take_dense(&mut self, columns: usize) -> Row<T>
+    where
+        T: Default,
+    {
+        if columns == self.width {
+            if let Some(row) = self.dense.pop() {
+                return row;
+            }
+        }
+        Row::new(columns)
+    }
+
+    pub fn retained_cells(&self) -> usize {
+        self.dense.iter().map(|r| r.inner.capacity()).sum::<usize>()
+            + self.prefixes.iter().map(Vec::capacity).sum::<usize>()
+    }
+}
+impl<T> HistoryRow<T> {
+    pub fn view(&self) -> RowView<'_, T> {
+        match self {
+            Self::Dense(row) => RowView::Dense(row),
+            Self::Compact(row) => RowView::Compact(row),
+        }
+    }
+
+    pub fn recycle(self, pool: &mut RowPool<T>) {
+        match self {
+            Self::Dense(row) => pool.recycle_dense(row),
+            Self::Compact(row) => pool.recycle_prefix(row.cells),
+        }
+    }
+
+    pub fn retained_cells(&self) -> usize {
+        match self {
+            Self::Dense(row) => row.inner.capacity(),
+            Self::Compact(row) => row.cells.capacity(),
+        }
+    }
+}
+impl<T: GridCell + Default + PartialEq> HistoryRow<T> {
+    pub fn from_dense(mut row: Row<T>, pool: &mut RowPool<T>) -> Self {
+        if !pool.compact {
+            return Self::Dense(row);
+        }
+        let columns = row.len();
+        let (Some(tail), Ok(columns_u32), Ok(occ)) =
+            (row.inner.last(), u32::try_from(columns), u32::try_from(row.occ))
+        else {
+            return Self::Dense(row);
+        };
+        let modified = row.occ.min(columns);
+        // Short output leaves blank cells nobody wrote past `occ`, so its scan stays short. A row
+        // written all the way across could only compact by comparing every cell with the last
+        // one. That is worth it for a blank tail, such as a line erased with a background color,
+        // but a row of one repeated glyph rarely repays the scan.
+        if modified == columns && !tail.is_blank() {
+            return Self::Dense(row);
+        }
+        let prefix_len = row.inner[..modified].iter().rposition(|c| c != tail).map_or(0, |i| i + 1);
+        if prefix_len + 1 > columns / 2 {
+            return Self::Dense(row);
+        }
+        let tail = tail.clone();
+        let mut cells = pool.prefixes.pop().unwrap_or_default();
+        cells.reserve(prefix_len + 1);
+        cells.resize_with(prefix_len, T::default);
+        row.inner[..prefix_len].swap_with_slice(&mut cells);
+        cells.push(tail);
+        pool.recycle_dense(row);
+        Self::Compact(CompactRow { cells, columns: columns_u32, occ })
+    }
+
+    /// A default tail can change width without cell conversion or reflow.
+    pub fn resize_default_tail(&mut self, columns: usize) -> bool {
+        let Self::Compact(row) = self else {
+            return false;
+        };
+        let Ok(columns_u32) = u32::try_from(columns) else {
+            return false;
+        };
+        if row.prefix().len() > columns || *row.tail() != T::default() {
+            return false;
+        }
+        row.columns = columns_u32;
+        row.occ = row.occ.min(columns_u32);
+        true
+    }
+
+    pub fn into_dense(self, pool: &mut RowPool<T>) -> Row<T> {
+        let Self::Compact(mut compact) = self else {
+            let Self::Dense(row) = self else { unreachable!() };
+            return row;
+        };
+        let mut row = pool.take_dense(compact.columns());
+        let tail = compact.cells.pop().expect("a compact row stores its tail");
+        let prefix_len = compact.cells.len();
+        for (cell, value) in row.inner.iter_mut().zip(compact.cells.drain(..)) {
+            *cell = value;
+        }
+        for cell in &mut row.inner[prefix_len..] {
+            *cell = tail.clone();
+        }
+        row.occ = compact.occ();
+        pool.recycle_prefix(compact.cells);
+        row
+    }
+
+    pub fn materialize(&mut self, pool: &mut RowPool<T>) -> &mut Row<T> {
+        if matches!(self, Self::Compact(_)) {
+            let old = std::mem::replace(self, Self::Dense(Row::default()));
+            *self = Self::Dense(old.into_dense(pool));
+        }
+        match self {
+            Self::Dense(row) => row,
+            Self::Compact(_) => unreachable!(),
+        }
+    }
+}
+
+/// Read-only access is explicit. It cannot be turned into a mutable slice.
+pub enum RowView<'a, T> {
+    Dense(&'a Row<T>),
+    Compact(&'a CompactRow<T>),
+}
+
+/// Compact history is a stored prefix plus a repeated tail, not `width` cells.
+pub enum RowParts<'a, T> {
+    Dense(&'a [T]),
+    Compact { prefix: &'a [T], tail: &'a T, tail_count: usize },
+}
+impl<T> Copy for RowView<'_, T> {}
+impl<T> Clone for RowView<'_, T> {
+    fn clone(&self) -> Self {
+        *self
+    }
+}
+impl<'a, T> RowView<'a, T> {
+    pub fn len(self) -> usize {
+        match self {
+            Self::Dense(row) => row.len(),
+            Self::Compact(row) => row.columns(),
+        }
+    }
+
+    pub fn is_empty(self) -> bool {
+        self.len() == 0
+    }
+
+    pub fn is_clear(self) -> bool
+    where
+        T: GridCell,
+    {
+        self.iter().all(GridCell::is_empty)
+    }
+
+    pub fn cell(self, column: Column) -> &'a T {
+        match self {
+            Self::Dense(row) => &row[column],
+            Self::Compact(row) => {
+                assert!(column.0 < row.columns());
+                row.prefix().get(column.0).unwrap_or(row.tail())
+            },
+        }
+    }
+
+    pub fn iter(self) -> RowCells<'a, T> {
+        match self {
+            Self::Dense(row) => RowCells { prefix: row.inner.iter(), tail: None, remaining: 0 },
+            Self::Compact(row) => RowCells {
+                prefix: row.prefix().iter(),
+                tail: Some(row.tail()),
+                remaining: row.columns() - row.prefix().len(),
+            },
+        }
+    }
+
+    /// Locate the last matching cell without walking a repeated tail.
+    pub fn parts(self) -> RowParts<'a, T> {
+        match self {
+            Self::Dense(row) => RowParts::Dense(row.cells()),
+            Self::Compact(row) => RowParts::Compact {
+                prefix: row.prefix(),
+                tail: row.tail(),
+                tail_count: row.columns() - row.prefix().len(),
+            },
+        }
+    }
+
+    pub fn copy_into(self, dest: &mut [T])
+    where
+        T: Clone,
+    {
+        assert_eq!(dest.len(), self.len());
+        match self.parts() {
+            RowParts::Dense(cells) => dest.clone_from_slice(cells),
+            RowParts::Compact { prefix, tail, tail_count } => {
+                dest[..prefix.len()].clone_from_slice(prefix);
+                dest[prefix.len()..].fill(tail.clone());
+                debug_assert_eq!(dest.len() - prefix.len(), tail_count);
+            },
+        }
+    }
+
+    /// Locate the last matching cell without walking a repeated tail.
+    pub fn last_matching(self, mut predicate: impl FnMut(&T) -> bool) -> Option<usize> {
+        match self {
+            Self::Dense(row) => row.inner.iter().rposition(predicate),
+            Self::Compact(row) => {
+                if row.columns() > row.prefix().len() && predicate(row.tail()) {
+                    return Some(row.columns() - 1);
+                }
+                row.prefix().iter().rposition(predicate)
+            },
+        }
+    }
+
+    pub(super) fn occ(self) -> usize {
+        match self {
+            Self::Dense(row) => row.occ,
+            Self::Compact(row) => row.occ(),
+        }
+    }
+}
+pub struct RowCells<'a, T> {
+    prefix: std::slice::Iter<'a, T>,
+    tail: Option<&'a T>,
+    remaining: usize,
+}
+impl<'a, T> Iterator for RowCells<'a, T> {
+    type Item = &'a T;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        if let Some(cell) = self.prefix.next() {
+            return Some(cell);
+        }
+        if self.remaining == 0 {
+            return None;
+        }
+        self.remaining -= 1;
+        self.tail
+    }
+
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        let len = self.prefix.len() + self.remaining;
+        (len, Some(len))
+    }
+}
+impl<T> DoubleEndedIterator for RowCells<'_, T> {
+    fn next_back(&mut self) -> Option<Self::Item> {
+        if self.remaining == 0 {
+            return self.prefix.next_back();
+        }
+        self.remaining -= 1;
+        self.tail
+    }
+}
+impl<T> ExactSizeIterator for RowCells<'_, T> {}
+impl<T> std::iter::FusedIterator for RowCells<'_, T> {}
