{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["openai"],
  "provider": {
    "openai": {
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      }
    }
  },
  "permission": {
    "*": "deny",
    "read": {
      "*": "deny",
      "release-notes-input.md": "allow"
    },
    "edit": {
      "*": "deny",
      "release-notes.md": "allow"
    }
  }
}
