+fn push_cell_text_repeated(out: &mut String, cell: &TermCell, count: usize) {
+    if count == 0 {
+        return;
+    }
+    if count == 1 || cell.zerowidth().is_some_and(|chars| !chars.is_empty()) {
+        for _ in 0..count {
+            push_cell_text_str(out, cell);
+        }
+        return;
+    }
+    #[cfg(feature = "terminal-images")]
+    if cell.c == PLACEHOLDER {
+        out.extend(std::iter::repeat_n(' ', count));
+        return;
+    }
+    let ch = if cell.flags.contains(CellFlags::HIDDEN) {
+        ' '
+    } else {
+        cell.c
+    };
+    out.extend(std::iter::repeat_n(ch, count));
+}
