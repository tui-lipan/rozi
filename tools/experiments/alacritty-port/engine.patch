+//! Compare compact storage against the unchanged registry engine after mixed input and resize.
+use alacritty_terminal as compact;
+use compact::grid::Dimensions;
+use dense::grid::Dimensions as _;
+
+#[derive(Clone, Copy)]
+struct Listener;
+impl compact::event::EventListener for Listener {
+    fn send_event(&self, _: compact::event::Event) {}
+}
+impl dense::event::EventListener for Listener {
+    fn send_event(&self, _: dense::event::Event) {}
+}
+
+#[derive(Clone, Copy)]
+struct Size {
+    rows: usize,
+    cols: usize,
+}
+impl compact::grid::Dimensions for Size {
+    fn total_lines(&self) -> usize {
+        self.rows
+    }
+
+    fn screen_lines(&self) -> usize {
+        self.rows
+    }
+
+    fn columns(&self) -> usize {
+        self.cols
+    }
+}
+impl dense::grid::Dimensions for Size {
+    fn total_lines(&self) -> usize {
+        self.rows
+    }
+
+    fn screen_lines(&self) -> usize {
+        self.rows
+    }
+
+    fn columns(&self) -> usize {
+        self.cols
+    }
+}
+
+fn compare(
+    actual: &compact::term::Term<Listener>,
+    expected: &dense::term::Term<Listener>,
+    step: usize,
+) {
+    let a = actual.grid();
+    let e = expected.grid();
+    assert_eq!(
+        (a.total_lines(), a.columns(), a.display_offset()),
+        (e.total_lines(), e.columns(), e.display_offset()),
+        "step {step}"
+    );
+    assert_eq!(
+        (a.cursor.point.line.0, a.cursor.point.column.0, a.cursor.input_needs_wrap),
+        (e.cursor.point.line.0, e.cursor.point.column.0, e.cursor.input_needs_wrap),
+        "cursor at step {step}"
+    );
+    for y in -(a.history_size() as i32)..a.screen_lines() as i32 {
+        for x in 0..a.columns() {
+            let c = a.read_row(compact::index::Line(y)).cell(compact::index::Column(x));
+            let d = &e[dense::index::Line(y)][dense::index::Column(x)];
+            assert_eq!(
+                (c.c, c.fg, c.bg, c.flags.bits(), c.zerowidth(), c.underline_color()),
+                (d.c, d.fg, d.bg, d.flags.bits(), d.zerowidth(), d.underline_color()),
+                "cell {y},{x} at step {step}"
+            );
+            let c_link = c.hyperlink();
+            let d_link = d.hyperlink();
+            assert_eq!(
+                c_link.as_ref().map(|h| (h.id(), h.uri())),
+                d_link.as_ref().map(|h| (h.id(), h.uri()))
+            );
+        }
+    }
+}
+
+#[derive(Clone, Copy)]
+enum Compaction {
+    Off,
+    On,
+    /// Toggled during the run, which expands compact history and starts compacting again.
+    Toggled,
+}
+
+#[test]
+fn mixed_output_resize_matches_dense_engine_without_compaction() {
+    run(Compaction::Off);
+}
+
+#[test]
+fn mixed_output_resize_matches_dense_engine_with_compaction() {
+    run(Compaction::On);
+}
+
+#[test]
+fn mixed_output_resize_matches_dense_engine_when_compaction_is_toggled() {
+    run(Compaction::Toggled);
+}
+
+fn run(compaction: Compaction) {
+    let size = Size { rows: 9, cols: 32 };
+    let mut actual = compact::term::Term::new(
+        compact::term::Config { scrolling_history: 64, ..Default::default() },
+        &size,
+        Listener,
+    );
+    let mut expected = dense::term::Term::new(
+        dense::term::Config { scrolling_history: 64, ..Default::default() },
+        &size,
+        Listener,
+    );
+    if !matches!(compaction, Compaction::Off) {
+        actual.grid_mut().set_compact_history(true);
+    }
+    let mut a_parser = compact::vte::ansi::Processor::<compact::vte::ansi::StdSyncHandler>::new();
+    let mut e_parser = dense::vte::ansi::Processor::<dense::vte::ansi::StdSyncHandler>::new();
+    let inputs = [
+        "short log\r\n",
+        "\x1b[31mred\x1b[0m\r\n",
+        "界e\u{301}\r\n",
+        "\x1b[44m\x1b[K\x1b[0m\r\n",
+        "\x1b]8;id=x;https://example.org\x1b\\link\x1b]8;;\x1b\\\r\n",
+        "long line of text which wraps across multiple rows in the viewport\r\n",
+        "\x1b[2;6r\x1b[6;1Hregion\n\n\x1b[r",
+        "\x1b[2J\x1b[H",
+        "\x1b[?1049hALT\x1b[?1049l",
+        "\x1b[2S",
+        "\x1b[1T",
+        "\r\x1b[3@insert\x1b[2P",
+        "\x1b[4;1H\x1b[2L\x1b[M",
+    ];
+    let mut seed = 7_u64;
+    let mut compact_rows_seen = 0;
+    for step in 0..400 {
+        seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1);
+        let input =
+            if step < 80 { inputs[step % 6] } else { inputs[(seed >> 32) as usize % inputs.len()] };
+        a_parser.advance(&mut actual, input.as_bytes());
+        e_parser.advance(&mut expected, input.as_bytes());
+        if step % 13 == 0 {
+            let size =
+                Size { rows: 4 + (seed as usize % 9), cols: 7 + ((seed >> 32) as usize % 40) };
+            actual.resize(size);
+            expected.resize(size);
+        }
+        if step % 37 == 0 {
+            let limit = (seed >> 32) as usize % 65;
+            actual.grid_mut().update_history(limit);
+            expected.grid_mut().update_history(limit);
+        }
+        if matches!(compaction, Compaction::Toggled) && step % 53 == 0 {
+            let grid = actual.grid_mut();
+            let enabled = grid.compact_history();
+            grid.set_compact_history(!enabled);
+        }
+        compare(&actual, &expected, step);
+        let grid = actual.grid();
+        compact_rows_seen += (1..=grid.history_size() as i32)
+            .filter(|n| {
+                matches!(
+                    grid.read_row(compact::index::Line(-n)),
+                    compact::grid::history::RowView::Compact(_)
+                )
+            })
+            .count();
+    }
+
+    // Otherwise the comparison above would pass without ever reading a compact row.
+    match compaction {
+        Compaction::Off => assert_eq!(compact_rows_seen, 0),
+        Compaction::On | Compaction::Toggled => assert!(compact_rows_seen > 0),
+    }
+}
