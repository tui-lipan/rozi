+
+    assert!(!grid.compact_history());
+    assert_eq!(grid[Line(-1)][Column(1)], cell('b'));
+    grid[Line(-1)][Column(2)] = cell('c');
+    assert_eq!(*grid.read_row(Line(-1)).cell(Column(2)), cell('c'));
+}
