+use super::*;
+
+impl<T> Grid<T> {
+    /// Explicit read access across viewport and retained history.
+    pub fn read_row(&self, line: Line) -> RowView<'_, T> {
+        if line.0 >= 0 {
+            return RowView::Dense(&self.raw[line]);
+        }
+        let index = self
+            .history
+            .len()
+            .checked_sub(line.0.unsigned_abs() as usize)
+            .expect("history row");
+        self.history[index].view()
+    }
+    pub fn read_cell(&self, point: Point) -> &T {
+        self.read_row(point.line).cell(point.column)
+    }
+
+    pub(super) fn evict_history(&mut self, count: usize) {
+        for _ in 0..count {
+            if let Some(row) = self.history.pop_front() {
+                row.recycle(&mut self.row_pool);
+            }
+        }
+        self.uncompacted = self.uncompacted.min(self.history.len());
+    }
+    pub fn pending_history_rows(&self) -> usize {
+        self.uncompacted
+    }
+
+    pub fn retained_history_cells(&self) -> usize {
+        self.history
+            .iter()
+            .map(HistoryRow::retained_cells)
+            .sum::<usize>()
+            + self.row_pool.retained_cells()
+    }
+}
+impl<T: Default + Clone + PartialEq> Grid<T> {
+    /// Unusual historical mutation has an explicit materialization boundary.
+    pub fn history_row_mut(&mut self, line: Line) -> &mut DenseRow<T> {
+        if line.0 >= 0 {
+            return &mut self.raw[line];
+        }
+        let index = self
+            .history
+            .len()
+            .checked_sub(line.0.unsigned_abs() as usize)
+            .expect("history row");
+        self.history[index].materialize(&mut self.row_pool)
+    }
+    pub(super) fn archive_viewport_row(&mut self, line: Line) {
+        self.row_pool.set_width(self.columns);
+        if self.history.len() == self.max_scroll_limit {
+            self.evict_history(1);
+        }
+        let row = std::mem::take(&mut self.raw[line]);
+        if self.history_batch == 0 {
+            self.history
+                .push_back(HistoryRow::from_dense(row, &mut self.row_pool));
+        } else {
+            self.history.push_back(HistoryRow::Dense(row));
+            self.uncompacted += 1;
+            if self.uncompacted >= self.history_window + self.history_batch {
+                self.compact_oldest_pending(self.history_batch);
+            }
+        }
+        self.raw[line] = self.row_pool.take_dense(self.columns);
+    }
+
+    fn compact_oldest_pending(&mut self, count: usize) {
+        let start = self.history.len() - self.uncompacted;
+        for index in start..start + count {
+            let row = std::mem::replace(
+                &mut self.history[index],
+                HistoryRow::Dense(DenseRow::default()),
+            );
+            self.history[index] = match row {
+                HistoryRow::Dense(row) => HistoryRow::from_dense(row, &mut self.row_pool),
+                compact => compact,
+            };
+        }
+        self.uncompacted -= count;
+    }
+
+    /// Pay all deferred work, including the retained recent window, inside benchmark timers.
+    pub fn finish_history_compaction(&mut self) {
+        self.compact_oldest_pending(self.uncompacted);
+    }
+
+    /// Move row ownership into the reflow pass without expanding compact history.
+    pub(super) fn take_reflow_rows(&mut self) -> Vec<HistoryRow<T>> {
+        let mut rows: Vec<_> = self
+            .raw
+            .take_all()
+            .into_iter()
+            .map(HistoryRow::Dense)
+            .collect();
+        rows.extend(self.history.drain(..).rev());
+        self.uncompacted = 0;
+        rows
+    }
+    pub(super) fn replace_reflow_rows(&mut self, rows: Vec<HistoryRow<T>>) {
+        let mut rows = rows.into_iter();
+        let viewport = rows
+            .by_ref()
+            .take(self.lines)
+            .map(|r| r.into_dense(&mut self.row_pool))
+            .collect();
+        self.raw.replace_viewport(viewport);
+        self.history = rows
+            .map(|r| match r {
+                HistoryRow::Dense(row) => HistoryRow::from_dense(row, &mut self.row_pool),
+                compact => compact,
+            })
+            .collect();
+        self.history.make_contiguous().reverse();
+        self.uncompacted = 0;
+    }
+}
