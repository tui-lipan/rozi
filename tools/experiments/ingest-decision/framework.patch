+    #[test]
+    fn bulk_row_snapshot_matches_display_iter_at_live_and_scrolled_offsets() {
+        let mut screen = TerminalScreen::new(8, 20, 40);
+        screen.process_bytes(
+            b"plain line\r\n\
+              \x1b]8;;https://example.com\x1b\\link text\x1b]8;;\x1b\\\r\n\
+              \x1b[31mred\x1b[0m tail\r\n\
+              \xe6\x9d\xb1\xe4\xba\xac e\xcc\x81 \xf0\x9f\xa6\x80\r\n\
+              wrapped-abcdefghijklmnopqrstuvwxyz\r\n",
+        );
+        for i in 0..50 {
+            screen.process_bytes(format!("row {i}\r\n").as_bytes());
+        }
+        let rows = screen.rows;
+        let cols = screen.cols;
+        let palette = screen.palette();
+        let history = screen.total_scrollback_rows();
+        for offset in [0, 4, 8, 32, history] {
+            screen.set_scrollback(offset);
+            let via_iter = {
+                let grid = screen.term.grid();
+                renderable_content_lines(
+                    grid.display_iter(),
+                    grid.display_offset(),
+                    rows,
+                    cols,
+                    palette,
+                )
+            };
+            let via_bulk = {
+                let grid = screen.term.grid();
+                renderable_content_lines_from_rows(grid, grid.display_offset(), rows, cols, palette)
+            };
+            assert_eq!(via_iter, via_bulk, "offset {offset}");
+        }
+    }
