+        let pointer = row.inner.as_ptr();
+        for _ in 0..100 {
+            let history = HistoryRow::from_dense(row, &mut pool);
+            assert!(matches!(history, HistoryRow::Compact(_)));
+            assert!(history.retained_cells() < 10);
+            assert!(history.view().iter().eq((&original).into_iter()));
+            row = history.into_dense(&mut pool);
