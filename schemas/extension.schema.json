{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rozi.tui-lipan.dev/schemas/extension.schema.json",
  "title": "Rozi extension manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "extension"
  ],
  "$defs": {
    "settingValue": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    }
  },
  "properties": {
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "api"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "api": {
          "const": 1
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "min_rozi": {
          "description": "Oldest Rozi this extension works with, as a semver version. An older Rozi reports the extension as incompatible instead of loading it.",
          "type": "string"
        },
        "platforms": {
          "description": "Operating systems this extension runs on. Omit for all of them.",
          "type": "array",
          "items": {
            "enum": [
              "linux",
              "macos",
              "windows",
              "freebsd",
              "netbsd"
            ]
          }
        },
        "homepage": {
          "description": "Where to read more about this extension. Rozi never fetches it.",
          "type": "string",
          "pattern": "^https?://"
        },
        "screenshots": {
          "description": "Images of the extension, as paths relative to the repository root, shown on the extension index website.",
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^(?!.*(^|/)\\.{1,2}(/|$))[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*\\.(png|jpg|jpeg|webp)$"
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "label": {
            "type": "string"
          },
          "exec": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "shell": {
            "type": "string",
            "minLength": 1
          },
          "send": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "description": "Suggested chord, as the key steps inside the reserved extension space: \"b\" means <prefix> x b."
          },
          "placement": {
            "enum": [
              "client",
              "active-session"
            ],
            "default": "client",
            "description": "Where the command's process runs: on the client, or on the host of the session on screen. `send` commands take no placement."
          }
        },
        "oneOf": [
          {
            "required": [
              "exec"
            ]
          },
          {
            "required": [
              "shell"
            ]
          },
          {
            "required": [
              "send"
            ]
          }
        ]
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "exec": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "shell": {
            "type": "string",
            "minLength": 1
          },
          "cwd": {
            "type": "string"
          },
          "restart": {
            "enum": [
              "on-failure",
              "always",
              "never"
            ]
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "placement": {
            "enum": [
              "client",
              "active-session",
              "each-host",
              "each-session"
            ],
            "default": "client",
            "description": "Where, and how many, instances run: one on the client; one on the active session's host; one on every host with an attached session; or one per attached session, on its host."
          },
          "session_scope": {
            "enum": [
              "active",
              "attached"
            ],
            "default": "active",
            "description": "Which sessions an `each-host` or `each-session` instance may list and publish rows into: only the session on screen, or every attached session within its placement. Other pane commands stay on the session on screen."
          }
        },
        "oneOf": [
          {
            "required": [
              "exec"
            ]
          },
          {
            "required": [
              "shell"
            ]
          }
        ]
      }
    },
    "navigation_targets": {
      "type": "array",
      "description": "Static foreground-program registrations for split-aware smart-focus routing.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "programs"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "programs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "suggested_keybindings": {
      "type": "array",
      "description": "Best-effort bindings for explicitly extension-bindable core actions.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "key"
        ],
        "properties": {
          "action": {
            "enum": [
              "smart-focus-left",
              "smart-focus-down",
              "smart-focus-up",
              "smart-focus-right"
            ]
          },
          "key": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "description": "Agent definitions. Ids are namespaced <extension>.<id> once loaded.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "match"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "label": {
            "type": "string"
          },
          "base": {
            "type": "boolean",
            "description": "Apply Rozi's shared blocked/working vocabulary. Defaults to true."
          },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "names": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "anyOf": [
              {
                "required": [
                  "names"
                ]
              },
              {
                "required": [
                  "paths"
                ]
              }
            ]
          },
          "states": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "blocked",
                    "working",
                    "idle",
                    "unknown"
                  ]
                },
                "scope": {
                  "enum": [
                    "all",
                    "footer"
                  ],
                  "description": "`screen` rules only. `footer` reads the last 8 non-empty lines."
                },
                "screen": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Needles over one observation. Matched against text Rozi has already lowercased.",
                  "properties": {
                    "all_of": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "any_of": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "none_of": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "regex": {
                      "type": "boolean",
                      "description": "Treat every needle in this group as a regular expression."
                    }
                  },
                  "anyOf": [
                    {
                      "required": [
                        "all_of"
                      ]
                    },
                    {
                      "required": [
                        "any_of"
                      ]
                    }
                  ]
                },
                "title": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Needles over one observation. Matched against text Rozi has already lowercased.",
                  "properties": {
                    "all_of": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "any_of": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "none_of": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "regex": {
                      "type": "boolean",
                      "description": "Treat every needle in this group as a regular expression."
                    }
                  },
                  "anyOf": [
                    {
                      "required": [
                        "all_of"
                      ]
                    },
                    {
                      "required": [
                        "any_of"
                      ]
                    }
                  ]
                }
              },
              "oneOf": [
                {
                  "required": [
                    "screen"
                  ]
                },
                {
                  "required": [
                    "title"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    "sidebar_tabs": {
      "type": "array",
      "description": "Sidebar tabs. Ids are namespaced <extension>.<name> once loaded.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "label"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "group": {
                  "type": "string",
                  "description": "Section header this entry sits under."
                },
                "run": {
                  "type": "string",
                  "minLength": 1
                },
                "send": {
                  "type": "string",
                  "minLength": 1
                },
                "popup": {
                  "type": "string",
                  "minLength": 1
                },
                "keep_open": {
                  "type": "boolean"
                }
              },
              "oneOf": [
                {
                  "required": [
                    "run"
                  ]
                },
                {
                  "required": [
                    "send"
                  ]
                },
                {
                  "required": [
                    "popup"
                  ]
                }
              ]
            }
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "interval": {
            "type": "integer",
            "minimum": 1
          },
          "on_click": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "run": {
                "type": "string",
                "minLength": 1
              },
              "send": {
                "type": "string",
                "minLength": 1
              },
              "popup": {
                "type": "string",
                "minLength": 1
              },
              "exec": {
                "type": "string",
                "minLength": 1
              },
              "keep_open": {
                "type": "boolean"
              }
            },
            "oneOf": [
              {
                "required": [
                  "run"
                ]
              },
              {
                "required": [
                  "send"
                ]
              },
              {
                "required": [
                  "popup"
                ]
              },
              {
                "required": [
                  "exec"
                ]
              }
            ]
          },
          "group_prefix": {
            "type": "string",
            "minLength": 1,
            "description": "Command tabs only. Output lines starting with it render as section headers."
          },
          "placement": {
            "enum": [
              "client",
              "active-session"
            ],
            "default": "client",
            "description": "Command tabs only. Where the listing command and an on_click exec run."
          },
          "settings": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_-]+$"
            },
            "description": "Keys of declared [settings] this tab offers in its settings picker, in order. Lists of strings cannot be offered."
          },
          "suggested_location": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dock",
              "panel"
            ],
            "properties": {
              "dock": {
                "enum": [
                  "left",
                  "right"
                ]
              },
              "panel": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              }
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "entries"
            ]
          },
          {
            "required": [
              "command"
            ]
          }
        ]
      }
    },
    "settings": {
      "type": "object",
      "description": "Settings this extension understands, each its default value or a table describing it. Users override them in [extensions.<id>].",
      "propertyNames": {
        "pattern": "^[a-z0-9_-]+$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/settingValue"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "default"
            ],
            "properties": {
              "default": {
                "$ref": "#/$defs/settingValue"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "description": "The setting's name in the tab settings picker. Defaults to the key."
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "description": "One line shown while the setting is highlighted."
              },
              "choices": {
                "type": "array",
                "minItems": 1,
                "description": "String settings only. The allowed values; default must be one of them.",
                "items": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "value"
                      ],
                      "properties": {
                        "value": {
                          "type": "string",
                          "minLength": 1
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                }
              },
              "min": {
                "type": "integer",
                "description": "Integer settings only. Lowest allowed value."
              },
              "max": {
                "type": "integer",
                "description": "Integer settings only. Highest allowed value."
              }
            }
          }
        ]
      }
    },
    "sidebar_presets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "label",
          "layout"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "layout": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "left": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "width": {
                    "type": "integer",
                    "minimum": 16,
                    "maximum": 80
                  },
                  "panel_count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  },
                  "panels": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "weight": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "tabs": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "uniqueItems": true
                        }
                      }
                    }
                  }
                }
              },
              "right": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "width": {
                    "type": "integer",
                    "minimum": 16,
                    "maximum": 80
                  },
                  "panel_count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  },
                  "panels": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "weight": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "tabs": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "uniqueItems": true
                        }
                      }
                    }
                  }
                }
              },
              "hidden": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
