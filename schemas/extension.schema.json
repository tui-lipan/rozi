{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rozi.tui-lipan.dev/schemas/extension.schema.json",
  "title": "Rozi extension manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "extension"
  ],
  "properties": {
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "api"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "api": {
          "const": 1
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "label": {
            "type": "string"
          },
          "exec": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "shell": {
            "type": "string",
            "minLength": 1
          },
          "send": {
            "type": "string",
            "minLength": 1
          }
        },
        "oneOf": [
          {
            "required": [
              "exec"
            ]
          },
          {
            "required": [
              "shell"
            ]
          },
          {
            "required": [
              "send"
            ]
          }
        ]
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "exec": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "shell": {
            "type": "string",
            "minLength": 1
          },
          "cwd": {
            "type": "string"
          },
          "restart": {
            "enum": [
              "on-failure",
              "always",
              "never"
            ]
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "exec"
            ]
          },
          {
            "required": [
              "shell"
            ]
          }
        ]
      }
    },
    "agents": {
      "type": "array",
      "description": "Agent definitions. Ids are namespaced <extension>.<id> once loaded.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "match"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "label": {
            "type": "string"
          },
          "base": {
            "type": "boolean",
            "description": "Apply Rozi's shared blocked/working vocabulary. Defaults to true."
          },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "names": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "anyOf": [
              {
                "required": [
                  "names"
                ]
              },
              {
                "required": [
                  "paths"
                ]
              }
            ]
          },
          "states": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "blocked",
                    "working",
                    "idle",
                    "unknown"
                  ]
                },
                "scope": {
                  "enum": [
                    "all",
                    "footer"
                  ],
                  "description": "`screen` rules only. `footer` reads the last 8 non-empty lines."
                },
                "screen": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Needles over one observation. Matched against text Rozi has already lowercased.",
                  "properties": {
                    "all_of": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "any_of": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "none_of": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "regex": {
                      "type": "boolean",
                      "description": "Treat every needle in this group as a regular expression."
                    }
                  },
                  "anyOf": [
                    {
                      "required": [
                        "all_of"
                      ]
                    },
                    {
                      "required": [
                        "any_of"
                      ]
                    }
                  ]
                },
                "title": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Needles over one observation. Matched against text Rozi has already lowercased.",
                  "properties": {
                    "all_of": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "any_of": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "none_of": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "regex": {
                      "type": "boolean",
                      "description": "Treat every needle in this group as a regular expression."
                    }
                  },
                  "anyOf": [
                    {
                      "required": [
                        "all_of"
                      ]
                    },
                    {
                      "required": [
                        "any_of"
                      ]
                    }
                  ]
                }
              },
              "oneOf": [
                {
                  "required": [
                    "screen"
                  ]
                },
                {
                  "required": [
                    "title"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  }
}
