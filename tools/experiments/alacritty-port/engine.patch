+        .map(|indexed| (indexed.point.line.0, indexed.point.column.0, indexed.cell.c))
+        .collect();
+    let mut expected = Vec::new();
+    for line in 0..2 {
+        for col in 0..3 {
+            expected.push((line, col, grid[Line(line)][Column(col)].c));
+        }
