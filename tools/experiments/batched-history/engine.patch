+use alacritty_terminal::grid::{
+    DenseRow,
+    history::{HistoryRow, RowPool},
+};
+use alacritty_terminal::index::Column;
+use alacritty_terminal::term::cell::{Cell, Flags};
+use alacritty_terminal::vte::ansi::{Color, NamedColor};
+use criterion::{BatchSize, BenchmarkId, Criterion, criterion_group, criterion_main};
+use std::hint::black_box;
+const WIDTH: usize = 253;
+fn row(len: usize, kind: &str) -> DenseRow<Cell> {
+    let mut row = DenseRow::<Cell>::new(WIDTH);
+    for i in 0..len {
+        row[Column(i)].c = char::from(b'a' + (i % 26) as u8);
+        if kind == "unicode" && i + 1 < len && i % 2 == 0 {
+            row[Column(i)].c = '界';
+            row[Column(i)].flags = Flags::WIDE_CHAR;
+            row[Column(i)].push_zerowidth('\u{301}');
+        } else if kind == "unicode" && i % 2 == 1 {
+            row[Column(i)].c = ' ';
+            row[Column(i)].flags = Flags::WIDE_CHAR_SPACER;
+        }
+    }
+    if kind == "styled_tail" {
+        for cell in &mut row[Column(len)..] {
+            cell.bg = Color::Named(NamedColor::Blue);
+        }
+    }
+    row
+}
+fn warmed(len: usize, kind: &str) -> (DenseRow<Cell>, RowPool<Cell>) {
+    let mut pool = RowPool::default();
+    pool.set_width(WIDTH);
+    let history = HistoryRow::from_dense(row(len, kind), &mut pool);
+    (history.into_dense(&mut pool), pool)
+}
+fn costs(c: &mut Criterion) {
+    let mut group = c.benchmark_group("conversion_cost");
+    for kind in ["plain", "unicode", "styled_tail"] {
+        for len in [0, 8, 32, 80, WIDTH] {
+            let fixture = row(len, kind);
+            let modified = if kind == "styled_tail" { WIDTH } else { len };
+            group.bench_function(
+                BenchmarkId::new("tail_scan", format!("{kind}/{len}")),
+                |b| {
+                    b.iter(|| {
+                        let cells = black_box(&fixture);
+                        black_box(
+                            cells[..Column(modified)]
+                                .iter()
+                                .rposition(|c| c != &cells[Column(WIDTH - 1)]),
+                        )
+                    });
+                },
+            );
+            group.bench_function(
+                BenchmarkId::new("whole_conversion", format!("{kind}/{len}")),
+                |b| {
+                    b.iter_batched(
+                        || warmed(len, kind),
+                        |(row, mut pool)| black_box((HistoryRow::from_dense(row, &mut pool), pool)),
+                        BatchSize::PerIteration,
+                    );
+                },
+            );
+        }
+    }
+    for len in [0, 8, 32, 80, WIDTH] {
+        group.bench_function(BenchmarkId::new("prefix_swap", len), |b| {
+            b.iter_batched_ref(
+                || (row(len, "plain"), vec![Cell::default(); len]),
+                |(row, prefix)| {
+                    black_box(row)[..Column(len)].swap_with_slice(black_box(prefix));
+                },
+                BatchSize::PerIteration,
+            );
+        });
+        group.bench_function(BenchmarkId::new("dense_reset", len), |b| {
+            b.iter_batched_ref(
+                || row(len, "plain"),
+                |row| row.reset::<Color>(black_box(&Cell::default())),
+                BatchSize::PerIteration,
+            );
+        });
+        group.bench_function(BenchmarkId::new("warmed_eviction", len), |b| {
+            b.iter_batched_ref(
+                || {
+                    let (row, mut pool) = warmed(len, "plain");
+                    (Some(HistoryRow::from_dense(row, &mut pool)), pool)
+                },
+                |(row, pool)| row.take().unwrap().recycle(pool),
+                BatchSize::PerIteration,
+            );
+        });
+    }
+    group.finish();
+}
+criterion_group!(benches, costs);
+criterion_main!(benches);
