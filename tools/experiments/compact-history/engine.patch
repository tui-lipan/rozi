+    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        #[derive(Deserialize)]
+        struct Dense<T> {
+            inner: Vec<T>,
+            occ: usize,
+        }
+        let dense = Dense::deserialize(deserializer)?;
+        Ok(Self::from_vec(dense.inner, dense.occ))
     }
 }

