+#[derive(Clone, Copy, PartialEq, Eq)]
+enum RenderMode {
+    Legacy,
+    DenseIter,
+    Bulk,
+}
+
+fn experiment_render_mode() -> RenderMode {
+    static MODE: OnceLock<RenderMode> = OnceLock::new();
+    *MODE.get_or_init(
+        || match std::env::var("ROZI_EXPERIMENT_RENDER").ok().as_deref() {
+            Some("legacy") => RenderMode::Legacy,
+            Some("dense") => RenderMode::DenseIter,
+            _ => RenderMode::Bulk,
+        },
+    )
+}
+
+struct SnapshotRuns {
+    lines: Vec<Vec<Span>>,
+    hyperlinks: Vec<TerminalHyperlink>,
+    current_row: Option<usize>,
+    run_style: Option<Style>,
+    run_key: Option<StyleRunKey>,
+    run_text: String,
+}
+
+impl SnapshotRuns {
+    fn new(rows: usize) -> Self {
+        Self {
+            lines: vec![Vec::new(); rows],
+            hyperlinks: Vec::new(),
+            current_row: None,
+            run_style: None,
+            run_key: None,
+            run_text: String::new(),
+        }
+    }
+
+    fn set_row(&mut self, row: usize) {
+        if self.current_row == Some(row) {
+            return;
+        }
+        self.flush();
+        self.current_row = Some(row);
+    }
+
+    fn flush(&mut self) {
+        self.run_key = None;
+        let Some(row) = self.current_row else {
+            self.run_style = None;
+            self.run_text.clear();
+            return;
+        };
+        if self.run_text.is_empty() {
+            self.run_style = None;
+            return;
+        }
+        if let Some(style) = self.run_style.take() {
+            self.lines[row].push(Span::new(std::mem::take(&mut self.run_text)).style(style));
+        } else {
+            self.lines[row].push(Span::new(std::mem::take(&mut self.run_text)));
+        }
+    }
+
+    fn record_hyperlink(&mut self, cell: &TermCell, row: usize, start_col: usize, count: usize) {
+        let Some(link) = cell.hyperlink() else {
+            return;
+        };
+        let end_col = start_col + count;
+        if let Some(previous) = self.hyperlinks.last_mut()
+            && previous.row == row
+            && previous.end_col == start_col
+            && previous.uri.as_ref() == link.uri()
+        {
+            previous.end_col = end_col;
+        } else {
+            self.hyperlinks
+                .push(TerminalHyperlink::new(link.uri(), row, start_col..end_col));
+        }
+    }
+
+    fn append_styled_text(
+        &mut self,
+        cell: &TermCell,
+        palette: &TerminalColorPalette,
+        count: usize,
+    ) {
+        if count == 0 {
+            return;
+        }
+        let bits = style_run_bits(cell.flags);
+        if let Some((mapped_fg, mapped_bg)) =
+            style_run_progress(self.run_key.as_mut(), cell, bits, palette)
+        {
+            self.flush();
+            self.run_style = Some(style_from_mapped(mapped_fg, mapped_bg, bits));
+            self.run_key = Some(StyleRunKey {
+                fg: cell.fg,
+                bg: cell.bg,
+                mapped_fg,
+                mapped_bg,
+                bits,
+            });
+        }
+        push_cell_text_repeated(&mut self.run_text, cell, count);
+    }
+
+    fn append_cell(
+        &mut self,
+        cell: &TermCell,
+        row: usize,
+        col: usize,
+        palette: &TerminalColorPalette,
+    ) {
+        self.set_row(row);
+        self.record_hyperlink(cell, row, col, 1);
+        if cell
+            .flags
+            .intersects(CellFlags::WIDE_CHAR_SPACER | CellFlags::LEADING_WIDE_CHAR_SPACER)
+        {
+            return;
+        }
+        self.append_styled_text(cell, palette, 1);
+    }
+
+    fn append_repeated(
+        &mut self,
+        cell: &TermCell,
+        row: usize,
+        start_col: usize,
+        count: usize,
+        palette: &TerminalColorPalette,
+    ) {
+        self.set_row(row);
+        self.record_hyperlink(cell, row, start_col, count);
+        if cell
+            .flags
+            .intersects(CellFlags::WIDE_CHAR_SPACER | CellFlags::LEADING_WIDE_CHAR_SPACER)
+        {
+            return;
+        }
+        self.append_styled_text(cell, palette, count);
+    }
+
+    fn finish(mut self) -> (Vec<Vec<Span>>, Vec<TerminalHyperlink>) {
+        self.flush();
+        for line in &mut self.lines {
+            if line.is_empty() {
+                line.push(Span::new(""));
+            }
+        }
+        (self.lines, self.hyperlinks)
+    }
+}
+
+fn renderable_content_lines_from_rows(
+    grid: &Grid<TermCell>,
+    display_offset: usize,
+    rows: u16,
+    cols: u16,
+    palette: TerminalColorPalette,
+) -> (Vec<Vec<Span>>, Vec<TerminalHyperlink>) {
+    let mut runs = SnapshotRuns::new(usize::from(rows));
+    let max_cols = usize::from(cols);
+    for row in 0..usize::from(rows) {
+        let Ok(offset) = i32::try_from(display_offset) else {
+            continue;
+        };
+        let Ok(row_i) = i32::try_from(row) else {
+            continue;
+        };
+        let line = Line(row_i - offset);
+        if line < grid.topmost_line() || line > grid.bottommost_line() {
+            continue;
+        }
+        append_row_parts(
+            grid.display_row(row).parts(),
+            row,
+            max_cols,
+            &palette,
+            &mut runs,
+        );
+    }
+    runs.finish()
+}
+
+fn append_row_parts(
+    parts: RowParts<'_, TermCell>,
+    row: usize,
+    max_cols: usize,
+    palette: &TerminalColorPalette,
+    runs: &mut SnapshotRuns,
+) {
+    match parts {
+        RowParts::Dense(cells) => {
+            for (col, cell) in cells.iter().take(max_cols).enumerate() {
+                runs.append_cell(cell, row, col, palette);
+            }
+        }
+        RowParts::Compact {
+            prefix,
+            tail,
+            tail_count,
+        } => {
+            let prefix_len = prefix.len().min(max_cols);
+            for (col, cell) in prefix.iter().take(prefix_len).enumerate() {
+                runs.append_cell(cell, row, col, palette);
+            }
+            let tail_count = tail_count.min(max_cols.saturating_sub(prefix_len));
+            if tail_count > 0 {
+                runs.append_repeated(tail, row, prefix_len, tail_count, palette);
+            }
+        }
+    }
+}
+
+fn wrapline_flag(grid: &Grid<TermCell>, line: Line) -> bool {
+    if line.0 >= 0 {
+        grid[line][grid.last_column()]
+            .flags
+            .contains(CellFlags::WRAPLINE)
+    } else {
+        grid.read_row(line)
+            .cell(grid.last_column())
+            .flags
+            .contains(CellFlags::WRAPLINE)
+    }
+}
