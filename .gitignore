# Rust build artifacts
/target/

# rustfmt backups
**/*.rs.bk

# Debug symbols
*.pdb

# Local cargo overrides (e.g. patching tui-lipan to a sibling checkout for framework development).
# CI and a standalone clone must resolve tui-lipan from crates.io at the version Cargo.toml pins.
/.cargo/

# Documentation site (docs/ doubles as the VitePress source for rozi.tui-lipan.dev)
/docs/node_modules/
/docs/.vitepress/dist/
/docs/.vitepress/cache/
/docs/.vitepress/.temp/

# Editor / OS noise
*.swp
.DS_Store

# Local implementation planning notes
/docs/superpowers/plans/
.slim/deepwork/

# Installer copies served by the docs site; generated from the root scripts by
# docs/.vitepress/config.ts.
/docs/public/install
/docs/public/install.ps1
