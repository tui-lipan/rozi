@@ -0,0 +1,189 @@
+//! Throughput and read cost of a terminal with filled scrollback, through the public API only, so
+//! the same file measures `master` and this branch.
+
+use std::hint::black_box;
+
+use alacritty_terminal::event::{Event, EventListener};
+use alacritty_terminal::grid::{Dimensions, Scroll};
+use alacritty_terminal::term::test::TermSize;
+use alacritty_terminal::term::{Config, Term};
+use alacritty_terminal::vte::ansi::{Processor, StdSyncHandler};
+use criterion::{BatchSize, Criterion, criterion_group, criterion_main};
+
+#[derive(Clone, Copy)]
+struct Listener;
+
+impl EventListener for Listener {
+    fn send_event(&self, _: Event) {}
+}
+
+const COLUMNS: usize = 253;
+const LINES: usize = 64;
+const HISTORY: usize = 10_000;
+
+fn short_lines(count: usize) -> Vec<u8> {
+    let mut out = Vec::new();
+    for i in 0..count {
+        out.extend_from_slice(format!("short log record {i:08}\r\n").as_bytes());
+    }
+    out
+}
+
+fn full_lines(count: usize) -> Vec<u8> {
+    let mut out = Vec::new();
+    for i in 0..count {
+        let line: String =
+            (0..COLUMNS).map(|c| char::from(b'!' + ((i * 7 + c * 13) % 90) as u8)).collect();
+        out.extend_from_slice(line.as_bytes());
+    }
+    out
+}
+
+/// Full-width rows of one repeated character, like vtebench's `scrolling_fullscreen`: each row
+/// compacts to a single cell, but only after comparing every cell with the last.
+fn uniform_lines(count: usize) -> Vec<u8> {
+    let mut out = Vec::new();
+    for i in 0..count {
+        out.extend(std::iter::repeat_n(b'A' + (i % 26) as u8, COLUMNS));
+        // Without a line break the row would wrap, and a wrapped row's flagged last cell differs
+        // from the rest, so it would never compact.
+        out.extend_from_slice(b"\r\n");
+    }
+    out
+}
+
+/// A terminal whose scrollback is already full of `fill`, so every measured line evicts one.
+fn filled(fill: &[u8], compact: bool) -> (Term<Listener>, Processor<StdSyncHandler>) {
+    let size = TermSize::new(COLUMNS, LINES);
+    let config = Config { scrolling_history: HISTORY, ..Default::default() };
+    let mut term = Term::new(config, &size, Listener);
+    set_compact(&mut term, compact);
+    let mut parser = Processor::<StdSyncHandler>::new();
+    parser.advance(&mut term, fill);
+    (term, parser)
+}
+
+#[cfg(not(upstream_baseline))]
+fn set_compact(term: &mut Term<Listener>, compact: bool) {
+    term.grid_mut().set_compact_history(compact);
+}
+
+#[cfg(upstream_baseline)]
+fn set_compact(_: &mut Term<Listener>, compact: bool) {
+    assert!(!compact);
+}
+
+fn modes() -> &'static [(&'static str, bool)] {
+    if cfg!(upstream_baseline) {
+        &[("upstream", false)]
+    } else {
+        &[("dense", false), ("compact", true)]
+    }
+}
+
+fn ingest(c: &mut Criterion) {
+    let fill_short = short_lines(HISTORY + LINES);
+    let fill_full = full_lines(HISTORY + LINES);
+    let fill_uniform = uniform_lines(HISTORY + LINES);
+    let cases = [
+        ("short", short_lines(100_000)),
+        ("full", full_lines(100_000)),
+        ("uniform", uniform_lines(100_000)),
+    ];
+    let mut group = c.benchmark_group("ingest_100k");
+    group.sample_size(20);
+    for (name, input) in &cases {
+        let fill = match *name {
+            "short" => &fill_short,
+            "full" => &fill_full,
+            _ => &fill_uniform,
+        };
+        for &(mode, compact) in modes() {
+            group.bench_function(format!("{name}/{mode}"), |b| {
+                b.iter_batched_ref(
+                    || filled(fill, compact),
+                    |(term, parser)| parser.advance(term, black_box(input)),
+                    BatchSize::LargeInput,
+                )
+            });
+        }
+    }
+    group.finish();
+}
+
+fn read_scrollback(c: &mut Criterion) {
+    let fill = short_lines(HISTORY + LINES);
+    let mut group = c.benchmark_group("display_iter");
+    group.sample_size(30);
+    for &(mode, compact) in modes() {
+        for (name, scroll) in [("live", None), ("top", Some(Scroll::Top))] {
+            let (mut term, _) = filled(&fill, compact);
+            if let Some(scroll) = scroll {
+                term.scroll_display(scroll);
+            }
+            group.bench_function(format!("{name}/{mode}"), |b| {
+                b.iter(|| {
+                    let mut count = 0usize;
+                    for cell in term.grid().display_iter() {
+                        count += usize::from(cell.c != ' ');
+                    }
+                    black_box(count)
+                })
+            });
+        }
+    }
+    group.finish();
+}
+
+fn search_history(c: &mut Criterion) {
+    let fill = short_lines(HISTORY + LINES);
+    let mut group = c.benchmark_group("iterate_history");
+    group.sample_size(20);
+    for &(mode, compact) in modes() {
+        let (term, _) = filled(&fill, compact);
+        group.bench_function(mode, |b| {
+            b.iter(|| {
+                let grid = term.grid();
+                let start = alacritty_terminal::index::Point::new(
+                    grid.topmost_line(),
+                    alacritty_terminal::index::Column(0),
+                );
+                black_box(grid.iter_from(start).filter(|cell| cell.c == 'x').count())
+            })
+        });
+    }
+    group.finish();
+}
+
+/// vtebench's `dense_cells`: every cell of the alternate screen rewritten with its own SGR.
+fn dense_cells(c: &mut Criterion) {
+    let mut payload = b"\x1b[?1049h".to_vec();
+    for (offset, ch) in (b'A'..=b'Z').enumerate() {
+        payload.extend_from_slice(b"\x1b[H");
+        for line in 1..=LINES {
+            for column in 1..=COLUMNS {
+                let index = line + column + offset;
+                let fg = index % 156 + 100;
+                let bg = 255 - index % 156 + 100;
+                payload.extend_from_slice(
+                    format!("\x1b[38;5;{fg};48;5;{bg};1;3;4m{}", ch as char).as_bytes(),
+                );
+            }
+        }
+    }
+    let mut group = c.benchmark_group("alt_screen");
+    group.sample_size(20);
+    for &(mode, compact) in modes() {
+        group.bench_function(format!("dense_cells/{mode}"), |b| {
+            b.iter_batched_ref(
+                || filled(&[], compact),
+                |(term, parser)| parser.advance(term, black_box(&payload)),
+                BatchSize::LargeInput,
+            )
+        });
+    }
+    group.finish();
+}
+
+criterion_group!(benches, ingest, read_scrollback, search_history, dense_cells);
+criterion_main!(benches);
