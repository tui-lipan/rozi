+use std::hint::black_box;
+
+use criterion::{BenchmarkId, Criterion, criterion_group, criterion_main};
+use tui_lipan::prelude::TerminalScreen;
+use tui_lipan::snapshot_stages;
+
+const HISTORY: usize = 5_000;
+
+fn corpus(kind: &str, cols: u16, lines: usize) -> Vec<u8> {
+    let line = match kind {
+        "unicode" => "東京 e\u{301} 🦀 log record\r\n".to_owned(),
+        "dense" => {
+            let mut text: String = (0..cols)
+                .map(|col| char::from(b'a' + (col % 26) as u8))
+                .collect();
+            text.push_str("\r\n");
+            text
+        }
+        _ => "short log record\r\n".to_owned(),
+    };
+    line.repeat(lines).into_bytes()
+}
+
+fn populated(kind: &str) -> TerminalScreen {
+    let cols = 253;
+    let rows = 64;
+    let mut screen = TerminalScreen::new(rows, cols, HISTORY);
+    screen.process_bytes(&corpus(kind, cols, HISTORY + usize::from(rows) + 1));
+    screen
+}
+
+fn stages(c: &mut Criterion) {
+    let mut group = c.benchmark_group("span_assembly");
+    for kind in ["plain", "unicode", "dense"] {
+        group.bench_function(BenchmarkId::new("walk_cells", kind), |b| {
+            let screen = populated(kind);
+            b.iter(|| black_box(snapshot_stages::walk_cells(&screen)));
+        });
+        group.bench_function(BenchmarkId::new("walk_viewport", kind), |b| {
+            let screen = populated(kind);
+            b.iter(|| black_box(snapshot_stages::walk_viewport(&screen)));
+        });
+        group.bench_function(BenchmarkId::new("walk_dense_rows", kind), |b| {
+            let screen = populated(kind);
+            b.iter(|| black_box(snapshot_stages::walk_dense_rows(&screen)));
+        });
+        group.bench_function(BenchmarkId::new("map_styles", kind), |b| {
+            let screen = populated(kind);
+            b.iter(|| black_box(snapshot_stages::map_styles(&screen)));
+        });
+        group.bench_function(BenchmarkId::new("detect_runs", kind), |b| {
+            let screen = populated(kind);
+            b.iter(|| black_box(snapshot_stages::detect_runs(&screen)));
+        });
+        group.bench_function(BenchmarkId::new("detect_runs_cell", kind), |b| {
+            let screen = populated(kind);
+            b.iter(|| black_box(snapshot_stages::detect_runs_cell(&screen)));
+        });
+        group.bench_function(BenchmarkId::new("accumulate_text", kind), |b| {
+            let screen = populated(kind);
+            b.iter(|| black_box(snapshot_stages::accumulate_text(&screen)));
+        });
+        group.bench_function(BenchmarkId::new("build_lines", kind), |b| {
+            let screen = populated(kind);
+            b.iter(|| {
+                let (lines, links) = snapshot_stages::content_lines(&screen);
+                black_box((snapshot_stages::span_count(&lines), links.len()))
+            });
+        });
+        group.bench_function(BenchmarkId::new("join_text", kind), |b| {
+            let screen = populated(kind);
+            b.iter(|| black_box(snapshot_stages::join_snapshot_text(&screen).len()));
+        });
+        group.bench_function(BenchmarkId::new("wrap_flags", kind), |b| {
+            let screen = populated(kind);
+            b.iter(|| black_box(snapshot_stages::wrap_flags(&screen)));
+        });
+        group.bench_function(BenchmarkId::new("snapshot", kind), |b| {
+            let mut screen = populated(kind);
+            b.iter(|| black_box(snapshot_stages::rebuild_snapshot(&mut screen)));
+        });
+        group.bench_function(BenchmarkId::new("lines_dense_rows", kind), |b| {
+            let screen = populated(kind);
+            b.iter(|| {
+                let (lines, links) = snapshot_stages::content_lines_dense_rows(&screen);
+                black_box((snapshot_stages::span_count(&lines), links.len()))
+            });
+        });
+        group.bench_function(BenchmarkId::new("lines_attr_keyed", kind), |b| {
+            let screen = populated(kind);
+            b.iter(|| {
+                let (lines, links) = snapshot_stages::content_lines_attr_keyed(&screen);
+                black_box((snapshot_stages::span_count(&lines), links.len()))
+            });
+        });
+        group.bench_function(BenchmarkId::new("lines_dense_attr", kind), |b| {
+            let screen = populated(kind);
+            b.iter(|| {
+                let (lines, links) = snapshot_stages::content_lines_dense_attr(&screen);
+                black_box((snapshot_stages::span_count(&lines), links.len()))
+            });
+        });
+    }
+    group.finish();
+}
+
+criterion_group!(benches, stages);
+criterion_main!(benches);
