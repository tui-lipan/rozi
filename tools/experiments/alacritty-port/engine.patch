+use super::*;
+
+impl<T> Grid<T> {
+    /// Read any row, in the viewport or in history, whichever way it is stored.
+    pub fn read_row(&self, line: Line) -> RowView<'_, T> {
+        if line.0 >= 0 {
+            return RowView::Dense(&self.raw[line]);
+        }
+        self.history_row(line).view()
+    }
+
+    /// Whether rows scrolling into history may be stored compactly.
+    pub fn compact_history(&self) -> bool {
+        self.row_pool.is_compact()
+    }
+
+    fn history_index(&self, line: Line) -> usize {
+        debug_assert!(line.0 < 0);
+        self.history
+            .len()
+            .checked_sub(line.0.unsigned_abs() as usize)
+            .unwrap_or_else(|| panic!("history line {} is out of range", line.0))
+    }
+
+    pub(super) fn history_row(&self, line: Line) -> &HistoryRow<T> {
+        &self.history[self.history_index(line)]
+    }
+
+    pub(super) fn history_row_entry(&mut self, line: Line) -> &mut HistoryRow<T> {
+        let index = self.history_index(line);
+        &mut self.history[index]
+    }
+
+    pub fn read_cell(&self, point: Point) -> &T {
+        self.read_row(point.line).cell(point.column)
+    }
+
+    pub fn display_row(&self, viewport_row: usize) -> RowView<'_, T> {
+        let line = Line(viewport_row as i32 - self.display_offset as i32);
+        self.read_row(line)
+    }
+
+    pub(super) fn evict_history(&mut self, count: usize) {
+        for _ in 0..count {
+            if let Some(row) = self.history.pop_front() {
+                row.recycle(&mut self.row_pool);
+            }
+        }
+    }
+
+    pub fn retained_history_cells(&self) -> usize {
+        self.history.iter().map(HistoryRow::retained_cells).sum::<usize>()
+            + self.row_pool.retained_cells()
+    }
+}
+impl<T: GridCell + Default + PartialEq> Grid<T> {
+    /// Store rows that scroll into history compactly: the cells up to the last one that differs
+    /// from the final cell, plus that cell as a repeated tail.
+    ///
+    /// Off by default, and while it is off every history row stays a dense [`Row`]. Once it is
+    /// on, `grid[line]` with a negative `line` panics on a compact row: read history with
+    /// [`Grid::read_row`], and mutate it with [`Grid::history_row_mut`]. Turning it off expands
+    /// every compact row again.
+    pub fn set_compact_history(&mut self, enabled: bool) {
+        self.row_pool.set_compact(enabled);
+        if !enabled {
+            for row in &mut self.history {
+                row.materialize(&mut self.row_pool);
+            }
+        }
+    }
+
+    /// Mutable access to any row, expanding a compact history row first.
+    pub fn history_row_mut(&mut self, line: Line) -> &mut Row<T> {
+        if line.0 >= 0 {
+            return &mut self.raw[line];
+        }
+        let index = self.history_index(line);
+        self.history[index].materialize(&mut self.row_pool)
+    }
+
+    pub(super) fn archive_viewport_row(&mut self, line: Line) {
+        // Without compaction a full history hands its oldest row straight back to the viewport,
+        // so scrolling costs two row moves and no pool traffic.
+        if !self.row_pool.is_compact() && self.history.len() == self.max_scroll_limit {
+            if let Some(HistoryRow::Dense(mut oldest)) = self.history.pop_front() {
+                if oldest.len() == self.columns {
+                    std::mem::swap(&mut self.raw[line], &mut oldest);
+                    self.history.push_back(HistoryRow::Dense(oldest));
+                    return;
+                }
+                let row = std::mem::replace(&mut self.raw[line], Row::new(self.columns));
+                self.history.push_back(HistoryRow::Dense(row));
+                return;
+            }
+        }
+        self.row_pool.set_width(self.columns);
+        if self.history.len() == self.max_scroll_limit {
+            self.evict_history(1);
+        }
+        let row = std::mem::take(&mut self.raw[line]);
+        self.history.push_back(HistoryRow::from_dense(row, &mut self.row_pool));
+        self.raw[line] = self.row_pool.take_dense(self.columns);
+    }
+
+    /// Move row ownership into the reflow pass without expanding compact history.
+    pub(super) fn take_reflow_rows(&mut self) -> Vec<HistoryRow<T>> {
+        let mut rows: Vec<_> = self.raw.take_all().into_iter().map(HistoryRow::Dense).collect();
+        rows.extend(self.history.drain(..).rev());
+        rows
+    }
+
+    pub(super) fn replace_reflow_rows(&mut self, rows: Vec<HistoryRow<T>>) {
+        let mut rows = rows.into_iter();
+        let viewport =
+            rows.by_ref().take(self.lines).map(|r| r.into_dense(&mut self.row_pool)).collect();
+        self.raw.replace_viewport(viewport);
+        self.history = rows
+            .map(|r| match r {
+                HistoryRow::Dense(row) => HistoryRow::from_dense(row, &mut self.row_pool),
+                compact => compact,
+            })
+            .collect();
+        self.history.make_contiguous().reverse();
+    }
+}
