+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::term::cell::{Cell, Flags, Hyperlink};
+    use crate::vte::ansi::{Color, NamedColor};
+
+    fn sample() -> Row<Cell> {
+        let mut row: Row<Cell> = Row::new(253);
+        row[Column(0)].c = '界';
+        row[Column(0)].flags = Flags::WIDE_CHAR;
+        row[Column(0)].push_zerowidth('\u{301}');
+        row[Column(1)].flags = Flags::WIDE_CHAR_SPACER;
+        row
+    }
+
+    #[test]
+    fn compact_preserves_every_cell_and_reverse_iteration() {
+        let mut row = sample();
+        let dense = row.clone();
+        row.compact();
+        assert!(row.inner.capacity() < 10);
+        assert_eq!(row, dense);
+        assert!(row.iter().rev().eq(dense.iter().rev()));
+        assert_eq!(row.iter().len(), 253);
+        assert_eq!(row[Column(252)], dense[Column(252)]);
+        assert_eq!(row.last(), dense.last());
+    }
+
+    #[test]
+    fn compact_preserves_styled_linked_blank_tail() {
+        let mut row = sample();
+        for cell in row.as_mut_slice().iter_mut().skip(2) {
+            cell.bg = Color::Named(NamedColor::Red);
+            cell.set_hyperlink(Some(Hyperlink::new(
+                Some("id"),
+                "https://example.org".into(),
+            )));
+        }
+        let dense = row.clone();
+        row.compact();
+        assert!(row.inner.capacity() < 10);
+        assert_eq!(row, dense);
+        row[Column(200)].c = 'X';
+        assert_eq!(row[Column(199)], dense[Column(199)]);
+        assert_eq!(row[Column(201)], dense[Column(201)]);
+    }
+
+    #[test]
+    fn compact_falls_back_for_distinct_last_cell() {
+        let mut row = sample();
+        row[Column(252)].flags = Flags::WRAPLINE;
+        row.compact();
+        assert_eq!(row.inner.len(), 253);
+        assert!(row[Column(252)].flags.contains(Flags::WRAPLINE));
+    }
+
+    #[test]
+    fn compact_matches_dense_mutations() {
+        let mut row = sample();
+        let mut dense = row.clone();
+        row.compact();
+        assert_eq!(row.shrink(80), dense.shrink(80));
+        assert_eq!(row, dense);
+        row.compact();
+        row.grow(320);
+        dense.grow(320);
+        assert_eq!(row, dense);
+        row.compact();
+        assert_eq!(row.front_split_off(70), dense.front_split_off(70));
+        assert_eq!(row, dense);
+        row.compact();
+        row.reset(&Cell::default());
+        dense.reset(&Cell::default());
+        assert_eq!(row, dense);
+    }
+
+    #[test]
+    #[cfg(feature = "serde")]
+    fn compact_serde_keeps_dense_wire_format() {
+        let mut row = sample();
+        let dense = serde_json::to_string(&row).unwrap();
+        row.compact();
+        assert_eq!(serde_json::to_string(&row).unwrap(), dense);
+        let decoded: Row<Cell> = serde_json::from_str(&dense).unwrap();
+        assert_eq!(decoded, row);
+    }
+}
